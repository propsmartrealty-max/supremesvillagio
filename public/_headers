# Cloudflare Enterprise Edge Configuration
# Optimized for Tiered Cache, Edge WAF, HTTP/3, and Instant Edge Purging

# 1. Next.js Static Immutable Bundles
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  Cache-Tag: nextjs-static, supreme-assets

# 2. Optimized Media Assets & Floorplans
/images/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  Cache-Tag: supreme-media, floorplans

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  Cache-Tag: supreme-fonts

# 3. XML Sitemaps, Feeds & Discovery
/*.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800
  Cache-Tag: supreme-sitemaps, seo-feed, merchant-feed

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600, s-maxage=86400
  Cache-Tag: supreme-robots

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600, s-maxage=86400
  Cache-Tag: supreme-llms

# 4. Global Enterprise Security, Edge WAF & Instant Edge Revalidation for HTML
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: cross-origin
  X-Robots-Tag: all, max-image-preview:large, max-snippet:-1, max-video-preview:-1
  X-DNS-Prefetch-Control: on
  Cache-Tag: supreme-villagio, html-pages, real-estate-pune, somatane-villas, luxury-bungalows
  Link: <https://cdn.supremeuniversal.com>; rel="preconnect"; crossorigin
  Link: <https://d66htbxvzotmo.cloudfront.net>; rel="preconnect"; crossorigin
